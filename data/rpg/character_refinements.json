    {
      "id": "rinne_swordsman",
      "identity_id": "rinne",
      "active_class_id": "swordsman",
      "skill_id": "heavy_slash",
      "name": "破隙",
      "summary": "目标已有破甲时，重斩伤害系数额外+30个百分点；保留破甲。",
      "tactic": "先用破甲斩削弱防御，再以重斩追击；战意适合有余裕时铺垫。薄荷标记留给猎杀，勿把两种条件混用。",
      "mp_cost_add": 1,
      "cooldown_add": 0,
      "damage_condition": {
        "status_id": "armor_break",
        "coefficient_add": 0.3
      },
      "extra_effects": [],
      "unlock_level": 3,
      "techniques": [
        {
          "skill_id": "armor_break",
          "unlock_level": 4,
          "name": "崩刃",
          "summary": "施法前自身有战意时，伤害与破甲后追加15%虚弱，持续2次目标行动；不消耗战意。",
          "mp_cost_add": 1,
          "cooldown_add": 0,
          "extra_effects": [
            {
              "type": "apply_status",
              "status_id": "weaken",
              "magnitude": 0.15,
              "duration": 2,
              "clock": "target_slot",
              "requires": {
                "source_status": "battle_spirit"
              }
            }
          ]
        },
        {
          "skill_id": "sweep",
          "unlock_level": 5,
          "name": "断阵",
          "summary": "仅对施法前已有破甲的目标，在横扫伤害后附加30%缓速（下一次轮序），并消耗该目标破甲；其他目标只受伤害。",
          "mp_cost_add": 2,
          "cooldown_add": 1,
          "extra_effects": [
            {
              "type": "apply_status",
              "status_id": "slow",
              "magnitude": 0.3,
              "duration": 1,
              "clock": "round_snapshot",
              "requires": {
                "target_status": "armor_break"
              }
            },
            {
              "type": "consume_status",
              "status_id": "armor_break",
              "requires": {
                "target_status": "armor_break"
              }
            }
          ]
        }
      ]
