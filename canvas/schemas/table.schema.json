{
  "type": "object",
  "required": [
    "version",
    "id",
    "title",
    "columns",
    "rows"
  ],
  "properties": {
    "version": {
      "type": "number",
      "const": 1
    },
    "id": {
      "type": "string",
      "pattern": "^[a-zA-Z0-9_-]{1,100}$"
    },
    "title": {
      "type": "string",
      "maxLength": 200
    },
    "columns": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "title",
          "type"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-zA-Z0-9_-]{1,100}$"
          },
          "title": {
            "type": "string",
            "maxLength": 200
          },
          "type": {
            "anyOf": [
              {
                "type": "string",
                "const": "text"
              },
              {
                "type": "string",
                "const": "number"
              },
              {
                "type": "string",
                "const": "boolean"
              }
            ]
          },
          "width": {
            "type": "number",
            "minimum": 80,
            "maximum": 1200
          }
        },
        "additionalProperties": false
      },
      "minItems": 1,
      "maxItems": 100
    },
    "rows": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "cells"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-zA-Z0-9_-]{1,100}$"
          },
          "cells": {
            "type": "object",
            "patternProperties": {
              "^[a-zA-Z0-9_-]{1,100}$": {
                "anyOf": [
                  {
                    "type": "string",
                    "maxLength": 10000
                  },
                  {
                    "type": "number"
                  },
                  {
                    "type": "boolean"
                  },
                  {
                    "type": "null"
                  }
                ]
              }
            }
          }
        },
        "additionalProperties": false
      },
      "maxItems": 1000
    }
  },
  "additionalProperties": false
}
